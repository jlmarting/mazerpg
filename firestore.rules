rules_version = '2';

service cloud.firestore {

// ============================================================================
// Reglas Firestore — mazerpg
// ============================================================================
// ÁRBOL CERRADO. La app NO usa autenticación (todo el cliente escribe con el
// SDK web sin request.auth). El endurecimiento previo validaba la forma exacta
// de cada documento campo a campo, pero usaba construcciones que **deniegan en
// runtime** y rompían toda operación (verificado 2026-10-13):
//   * `String.size()` → error (no hay size() sobre string en estas reglas).
//   * comprobaciones de tipo numérico (`is number`/`is int`/`is float`) → no
//     casan con los números del SDK web.
//   * `allow list: if idValido(<comodín>)` → el comodín de colección no es un
//     string acotado en consultas → deniega list.
//   * `.get(k, default)` (2 args) → warning y valor nulo.
// Diseño actual: **solo se sirve el árbol `/partidas/**`**; todo lo demás queda
// denegado por el catch-all. Dentro del árbol, lectura y escritura permitidas
// (sin auth, como ya era la decisión documentada).
// (Pendiente opcional: re-endurecer con validación de forma usando SOLO
//  construcciones que compilen/rulen bien.)

match /databases/{database}/documents {

  // Todo el estado de partida vive bajo /partidas/{pid}/**
  match /partidas/{pid} {
    allow read, write: if true;
    match /{document=**} {
      allow read, write: if true;
    }
  }

  // Todo lo demás, denegado.
  match /{document=**} {
    allow read, write: if false;
  }
}
}
